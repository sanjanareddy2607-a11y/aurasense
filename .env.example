# AuraSense environment configuration (copy to .env and edit)
# Local defaults work without any changes. Production must override every secret.

# JWT signing key - generate a long random value for anything shared.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
AURASENSE_ENV=development

# Database. SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://aurasense:password@localhost:5432/aurasense
DATABASE_URL=sqlite:///./data/aurasense.db
DATA_DIR=./data

# Local WESAD installation (contains S2..S17 pickle directories).
# Not needed when backend/ml/artifacts is populated.
# WESAD_DIR=C:/path/to/BIO-EXP-PROJECT/WESAD

# Uploads, generated reports and model artefacts
STORAGE_DIR=./storage
ARTIFACTS_DIR=./ml/artifacts
MAX_UPLOAD_BYTES=12582912

# Researcher self-registration code (change before sharing)
RESEARCH_INVITE_CODE=AURA-RESEARCH

# Seed demonstration accounts/data on first API start (1 = on)
SEED_DEMO=1

# Seeded demonstration passwords. Change all four before a public deployment.
DEMO_INDIVIDUAL_PASSWORD=Demo1234!
DEMO_RESEARCHER_PASSWORD=Research1234!
DEMO_ADMIN_PASSWORD=Institution1234!
DEMO_COHORT_PASSWORD=DemoCohort123!

# Minimum aggregate cohort for institution insights
INSTITUTION_MIN_COHORT=5

# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
